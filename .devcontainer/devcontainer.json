{
  "name": "Flutter Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Web jarang dipakai -> tidak otomatis enable-web atau expose port.
  // Jika butuh web sekali waktu:
  // 1. flutter config --enable-web && flutter precache --web
  // 2. (Opsional) forwardPorts [8080]
  // 3. flutter run -d web-server --web-port=8080
  "postCreateCommand": "git lfs install --skip-repo && flutter pub get || true",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "GitHub.copilot"
      ]
    }
  },
  "remoteUser": "vscode"
}