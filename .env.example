# Copy to .env and fill in. Passed at build time: flutter run --dart-define-from-file=.env
# Never commit .env.

# Supabase project (Settings -> API Keys). Only the publishable key goes into the app.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: your own bots (defaults are the official Finoteku bots)
# TELEGRAM_BOT_USERNAME=YourBot
# WA_BOT_NUMBER=628xxxxxxxxxx
