# Environment variables for Finoteku
# Copy this file to .env and fill in your actual Supabase credentials
# NEVER commit .env file to version control!

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
APP_NAME=Finoteku
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database Configuration (for local development)
LOCAL_DB_NAME=finoteku_local.db
LOCAL_DB_VERSION=1

# API Configuration
API_TIMEOUT=30000
MAX_RETRY_ATTEMPTS=3

# Storage Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Notification Configuration
ENABLE_NOTIFICATIONS=true
NOTIFICATION_CHANNEL_ID=finoteku_notifications

# Analytics Configuration (optional)
ENABLE_ANALYTICS=false
ANALYTICS_ENDPOINT=

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=debug

# Security Configuration
ENABLE_BIOMETRICS=true
SESSION_TIMEOUT=3600000
ENCRYPTION_KEY_ALIAS=finoteku_key
